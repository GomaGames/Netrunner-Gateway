---
import Tile from '../components/Tile.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Netrunner Meetups in the Philippines">
  <Tile
    containerClass="manila"
    title="Manila"
    cta={[
      {
        action: "https://www.facebook.com/groups/NetrunnerPH",
        label: "Join the MetaManila City Grid FB community",
      },
      {
        action: "https://discord.gg/my8DCceYET",
        label: "Join the MetaManila City Grid Discord",
      },
    ]}
  >


    <h3>Thursday (<i>and Tuesday</i>) Weekly Meetup - Mandaluyong</h3>
    <p>Play Netrunner at Whimsy Game Cafe, Mandaluyong on Thursday 6:00pm. (and sometimes Tuesdays)</p>
    <p><a href="https://maps.app.goo.gl/Wbu2oJL8u4SXwuQH7">The Portal, Mayflower St, Greenfield District, Mandaluyong, Metro Manila, Philippines</a></p>
    <p><br></p>

    <h3>Friday Weekly Meetup - Makati</h3>
    <p>Play Netrunner at Hobbies and Sheets Salcedo, Makati on Friday 7:00pm.</p>
    <p><a href="https://maps.app.goo.gl/NxncSGnyTjXqxxWT6">100 Tordesillas Street, corner H.V. Dela Costa, Makati City, Metro Manila, Philippines</a></p>
    <p><br></p>

    <p>Contact @profwacko on <a href="https://discord.gg/my8DCceYET">Discord</a> for more info.</p>
  </Tile>
</Layout>
